{
  "name": "marc-edits",
  "productName": "Marc Edits",
  "version": "0.9.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "node build/write-root.cjs && vite build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.5",
    "vite": "^6.4.5",
    "wait-on": "^9.5.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "dependencies": {},
  "description": "Editor de vídeos de TikTok con Claude",
  "author": "Marc Edits",
  "build": {
    "appId": "com.marcedits.app",
    "productName": "Marc Edits",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Marc Edits",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}